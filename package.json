{
  "name": "digraphia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @digraphia/web dev",
    "build": "pnpm --filter @digraphia/web build",
    "preview": "pnpm --filter @digraphia/web preview",
    "test": "pnpm --filter @digraphia/core test",
